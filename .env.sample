APP_NAME=DIGITAL WALLET API
APP_VERSION=1.0.1
DEBUG=true
ENVIRONMENT=dev
DATABASE_URL=postgresql+psycopg://db_user:password@localhost:0000/db_name
TEST_DATABASE_URL=postgresql+psycopg://db_user:password@localhost:0000/db_name
ACCESS_TOKEN_SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_TIME=30
REFRESH_TOKEN_EXPIRE_TIME=1
REFRESH_TOKEN_SECRET_KEY=change-me
ALGORITHM=HS256
#2FA
TWO_FACTOR_SECRET_KEY=change-me
TWO_FACTOR_SALT=change-me
#email service
MAILEROO_BASE_URL=https://maileroo.com/
MAILEROO_DOMAIN_EMAIL=test@example.com
MAILERRO_KEY=test-maileroo-key

REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
#aws s3-compatible storage
AWS_ENDPOINT_URL_S3="https://s3.amazonaws.com"
AWS_ACCESS_KEY_ID="key"
AWS_SECRET_ACCESS_KEY="key"
AWS_REGION="region"